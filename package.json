{
  "name": "hyfrme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run sync:registry && npm run sync:catalog",
    "dev": "vite",
    "prebuild": "npm run sync:registry && npm run sync:catalog && npm run build:cli",
    "build": "tsc --noEmit && vite build",
    "check": "node scripts/build-catalog-data.mjs --check && npm run validate && npm run test:cli && tsc --noEmit",
    "validate": "node scripts/validate-catalog.mjs",
    "test:cli": "node scripts/test-cli.mjs",
    "verify:installer": "node scripts/verify-installer.mjs",
    "audit:upstream": "node scripts/audit-upstream.mjs",
    "generate:icons": "node scripts/generate-icon-ports.mjs",
    "generate:text": "node scripts/generate-text-ports.mjs --family text",
    "generate:core": "node scripts/generate-text-ports.mjs --family core",
    "generate:primitives": "node scripts/generate-text-ports.mjs --family primitive",
    "generate:icon-reference": "node scripts/generate-icon-reference.mjs",
    "generate:text-reference": "node scripts/generate-text-reference.mjs",
    "verify:icons": "node scripts/verify-icon-ports.mjs",
    "generate:icon-previews": "node scripts/generate-icon-showcase-previews.mjs",
    "verify:text": "node scripts/verify-text-ports.mjs --family text",
    "verify:core": "node scripts/verify-text-ports.mjs --family core",
    "verify:primitives": "node scripts/verify-text-ports.mjs --family primitive",
    "build:catalog": "node scripts/build-verified-catalog.mjs",
    "generate:thumbnails": "node scripts/generate-thumbnails.mjs",
    "sync:registry": "node scripts/sync-registry.mjs",
    "sync:catalog": "node scripts/build-catalog-data.mjs",
    "build:cli": "node scripts/build-cli-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.1",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
