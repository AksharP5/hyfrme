{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-store-badge-lockup",
  "type": "hyperframes:component",
  "title": "Store Badge Lockup",
  "description": "Settles a short headline above equal-size App Store and Google Play badges as a token-driven mobile end-card call to action.",
  "tags": [
    "prop",
    "ui-props",
    "mobile",
    "store-badges",
    "cta",
    "ask",
    "hyperframes-official"
  ],
  "jobs": [
    "ask"
  ],
  "family": "ui-props",
  "profile": "holdable",
  "evidence": "GAP B1 mobile close: app launches need a store-badge end card instead of a URL, and the registry coverage audit found no existing two-store download lockup.",
  "syncPoints": [
    {
      "id": "lockup-settled",
      "phase": "in",
      "offset": 1
    }
  ],
  "files": [
    {
      "path": "store-badge-lockup.html",
      "target": "compositions/components/store-badge-lockup.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "headline",
      "type": "string",
      "role": "content",
      "label": "Headline",
      "description": "Short action line shown above the store badges.",
      "default": "Get the app"
    },
    {
      "id": "showApple",
      "type": "enum",
      "role": "content",
      "label": "Show App Store",
      "description": "Show or hide the App Store badge.",
      "default": "yes",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ]
    },
    {
      "id": "showGoogle",
      "type": "enum",
      "role": "content",
      "label": "Show Google Play",
      "description": "Show or hide the Google Play badge.",
      "default": "yes",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ]
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "daa44fcd753d9055aa3c954ad74f09a4e4389780",
    "source": "registry/components/store-badge-lockup/registry-item.json",
    "name": "store-badge-lockup"
  }
}
