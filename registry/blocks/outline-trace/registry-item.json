{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "outline-trace",
  "type": "hyperframes:block",
  "title": "Outline Trace",
  "description": "Every glyph contour draws itself as a stroke, letter by letter, then the fill wipes up inside each letter and the stroke fades into it. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "typography",
    "effect",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT AND OFL-1.1",
  "bundledDependencies": [
    {
      "name": "opentype.js",
      "version": "2.0.0",
      "license": "MIT"
    }
  ],
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 2.5,
  "files": [
    {
      "path": "outline-trace.html",
      "target": "compositions/outline-trace.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "outline-trace.runtime.js",
      "target": "compositions/outline-trace.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "Inter-Latin.woff2",
      "target": "assets/fonts/Inter-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
