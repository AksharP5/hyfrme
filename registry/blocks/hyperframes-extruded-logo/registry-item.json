{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-extruded-logo",
  "type": "hyperframes:block",
  "title": "Extruded Logo",
  "description": "Beveled 3D letters flip up one by one, the word swings so light runs across the bevels, then settles for a readable hold. Chrome, gold or matte.",
  "tags": [
    "3d-object",
    "three-js",
    "webgl",
    "logo",
    "text",
    "extruded",
    "title-card",
    "hyperframes-official"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 5,
  "files": [
    {
      "path": "extruded-logo.html",
      "target": "compositions/extruded-logo.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "assets/fonts/Geist-Bold.typeface.json",
      "target": "compositions/assets/fonts/Geist-Bold.typeface.json",
      "type": "hyperframes:asset"
    },
    {
      "path": "assets/fonts/Geist-OFL.txt",
      "target": "compositions/assets/fonts/Geist-OFL.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Word or lettermark",
      "description": "Basic Latin letters, digits and punctuation only; other characters render as ?",
      "default": "NOVA",
      "maxLength": 8
    },
    {
      "id": "tagline",
      "type": "string",
      "role": "content",
      "label": "Tagline",
      "default": "Ships Thursday",
      "maxLength": 40
    },
    {
      "id": "finish",
      "type": "enum",
      "role": "style",
      "label": "Finish",
      "default": "chrome",
      "options": [
        {
          "value": "chrome",
          "label": "Chrome"
        },
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "matte",
          "label": "Matte clay"
        }
      ]
    },
    {
      "id": "rim_color",
      "type": "color",
      "role": "style",
      "label": "Rim light",
      "default": "#fff4e6"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Backdrop",
      "default": "#0c0d12"
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "c694785df5993191fec42ec84e9d65ea69f98ad8",
    "source": "registry/blocks/extruded-logo/registry-item.json",
    "name": "extruded-logo"
  }
}
