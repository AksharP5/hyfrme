{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "stepper",
  "type": "hyperframes:block",
  "title": "Stepper",
  "description": "A horizontal onboarding stepper whose progress is a pure function of a continuous step index (value-channel deviation). Every circle (fill, number, stroke-dash check) and connector (primary fill fraction) derives purely from the float position; useStepperTransition reads the frame and eases position between step indices. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT AND OFL-1.1",
  "bundledDependencies": [
    {
      "name": "culori",
      "version": "4.0.2",
      "license": "MIT"
    }
  ],
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 5,
  "files": [
    {
      "path": "stepper.html",
      "target": "compositions/stepper.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "stepper.runtime.js",
      "target": "compositions/stepper.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/culori-LICENSE",
      "target": "THIRD_PARTY_LICENSES/remocn/culori-LICENSE",
      "type": "hyperframes:asset"
    }
  ]
}
