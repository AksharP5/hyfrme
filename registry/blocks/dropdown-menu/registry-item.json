{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dropdown-menu",
  "type": "hyperframes:block",
  "title": "Dropdown Menu",
  "description": "A dropdown menu whose opened/closed state is a pure function of the timeline; the trigger reuses the Button primitive and the reveal panel composes DropdownMenuItem rows. The panel fade, scale, lift, and chevron are keyframed presets. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT AND OFL-1.1",
  "bundledDependencies": [
    {
      "name": "culori",
      "version": "4.0.2",
      "license": "MIT"
    }
  ],
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 4,
  "files": [
    {
      "path": "dropdown-menu.html",
      "target": "compositions/dropdown-menu.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "dropdown-menu.runtime.js",
      "target": "compositions/dropdown-menu.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/culori-LICENSE",
      "target": "THIRD_PARTY_LICENSES/remocn/culori-LICENSE",
      "type": "hyperframes:asset"
    }
  ]
}
