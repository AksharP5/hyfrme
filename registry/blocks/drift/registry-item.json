    "width": 1280,
    "height": 720
  },
  "duration": 3,
  "files": [
    {
      "path": "drift.html",
      "target": "compositions/drift.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "drift.runtime.js",
      "target": "compositions/drift.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-SemiBold.woff2",
      "target": "assets/fonts/Geist-SemiBold.woff2",
      "type": "hyperframes:asset"
    },
