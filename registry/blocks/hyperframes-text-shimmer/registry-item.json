{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-text-shimmer",
  "type": "hyperframes:component",
  "title": "Text Shimmer",
  "description": "A static headline receives one clean specular gradient sweep through its glyphs, then returns to its ordinary text color.",
  "tags": [
    "motion-primitive",
    "text-effects",
    "shimmer",
    "specular",
    "emphasis",
    "hyperframes-official"
  ],
  "jobs": [
    "emphasize"
  ],
  "family": "text-effects",
  "profile": "drift",
  "evidence": "design-inspiration/INDEX.md and viral-micro-interactions.md, animated text shimmer by jhey Tan",
  "files": [
    {
      "path": "text-shimmer.html",
      "target": "compositions/components/text-shimmer.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Headline",
      "description": "Text receiving the single shimmer pass.",
      "default": "Effortless"
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Hue of the specular shimmer band.",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "sweep_at",
      "type": "number",
      "role": "timing",
      "label": "Sweep start",
      "description": "Requested start time for the shimmer sweep.",
      "default": 1.2,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "unit": "s"
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "daa44fcd753d9055aa3c954ad74f09a4e4389780",
    "source": "registry/components/text-shimmer/registry-item.json",
    "name": "text-shimmer"
  }
}
