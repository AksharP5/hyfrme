{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "select",
  "type": "hyperframes:block",
  "title": "UI Select",
  "description": "A select whose opened/closed state is a pure function of the timeline; the trigger reuses the Button primitive and the reveal panel composes SelectItem rows. The panel fade, scale, lift, and chevron are keyframed presets. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT",
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 4,
  "files": [
    {
      "path": "select.html",
      "target": "compositions/select.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "select.runtime.js",
      "target": "compositions/select.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-SemiBold.woff2",
      "target": "assets/fonts/Geist-SemiBold.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    }
  ]
}
