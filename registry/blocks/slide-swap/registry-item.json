  "license": "MIT",
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 7,
  "files": [
    {
      "path": "slide-swap.html",
      "target": "compositions/slide-swap.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "slide-swap.runtime.js",
      "target": "compositions/slide-swap.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-SemiBold.woff2",
      "target": "assets/fonts/Geist-SemiBold.woff2",
      "type": "hyperframes:asset"
    },
    {
