  "name": "slide-swap",
  "type": "hyperframes:block",
  "title": "Slide Swap",
  "description": "A scene sequencer where the outgoing content is shoved off on an accelerating curve and the next springs in from the opposite edge, on one canvas, with no overlap. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "composition",
    "data",
    "remocn-port"
  ],
  "author": "Hyfrme",
