{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "button",
  "type": "hyperframes:block",
  "title": "Button",
  "description": "A button whose idle/hover/press/loading/success state is a pure function of the timeline; the loading state composes the Spinner motion atom. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT",
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 4.4,
  "files": [
    {
      "path": "button.html",
      "target": "compositions/button.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "button.runtime.js",
      "target": "compositions/button.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-SemiBold.woff2",
      "target": "assets/fonts/Geist-SemiBold.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    }
  ]
}
