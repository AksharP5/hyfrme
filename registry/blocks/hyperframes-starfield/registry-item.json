{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-starfield",
  "type": "hyperframes:block",
  "title": "Starfield",
  "description": "Seek-safe night-sky overlay: sparse or dense stars in three size tiers that twinkle and drift in two parallax layers, radial-masked to keep the frame center clear",
  "tags": [
    "starfield",
    "night-sky",
    "stars",
    "twinkle",
    "sky",
    "weather",
    "overlay",
    "ambient",
    "particles",
    "media-treatment-overlay",
    "loopable",
    "hyperframes-official"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 6,
  "variables": [
    {
      "id": "density",
      "type": "enum",
      "role": "style",
      "label": "Density",
      "description": "Star count across the frame.",
      "default": "sparse",
      "options": [
        {
          "value": "sparse",
          "label": "Sparse"
        },
        {
          "value": "dense",
          "label": "Dense"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Star color mix.",
      "default": "warm",
      "options": [
        {
          "value": "warm",
          "label": "Warm (white + yellow)"
        },
        {
          "value": "cool",
          "label": "Cool (white + blue)"
        },
        {
          "value": "white",
          "label": "White only"
        }
      ]
    },
    {
      "id": "speed",
      "type": "enum",
      "role": "style",
      "label": "Twinkle speed",
      "description": "How fast stars pulse.",
      "default": "slow",
      "options": [
        {
          "value": "slow",
          "label": "Slow"
        },
        {
          "value": "fast",
          "label": "Fast"
        }
      ]
    }
  ],
  "files": [
    {
      "path": "starfield.html",
      "target": "compositions/starfield.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/blocks/starfield.png",
    "video": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/blocks/starfield.mp4"
  },
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "c694785df5993191fec42ec84e9d65ea69f98ad8",
    "source": "registry/blocks/starfield/registry-item.json",
    "name": "starfield"
  }
}
