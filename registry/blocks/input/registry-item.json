{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "input",
  "type": "hyperframes:block",
  "title": "UI Input",
  "description": "A text input whose idle/hover/active/typing/invalid state is a pure function of the timeline; the focus ring, border, caret, and value reveal are keyframed presets. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT",
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 4,
  "files": [
    {
      "path": "input.html",
      "target": "compositions/input.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "input.runtime.js",
      "target": "compositions/input.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-SemiBold.woff2",
      "target": "assets/fonts/Geist-SemiBold.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    }
  ]
}
