{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-agent-cursor",
  "type": "hyperframes:component",
  "title": "Agent Cursor",
  "description": "An AI agent operating a UI: a cursor with an accent name label that types out each step, clicks each target with a small ring, and ends on a check.",
  "tags": [
    "cursor",
    "motion-primitive",
    "agent",
    "ai",
    "status",
    "click",
    "hyperframes-official"
  ],
  "files": [
    {
      "path": "agent-cursor.html",
      "target": "compositions/components/agent-cursor.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "jobs": [
    "demonstrate"
  ],
  "family": "pointers",
  "profile": "interaction",
  "syncPoints": [
    {
      "id": "first-click",
      "phase": "in",
      "offset": 2
    },
    {
      "id": "second-click",
      "phase": "in",
      "offset": 3.35
    },
    {
      "id": "done",
      "phase": "in",
      "offset": 3.65
    }
  ],
  "variables": [
    {
      "id": "agent_name",
      "type": "string",
      "role": "content",
      "label": "Agent name",
      "default": "Agent"
    },
    {
      "id": "steps",
      "type": "string",
      "role": "content",
      "label": "Status steps",
      "description": "Comma-separated: a reading line, one line per target, then a done line.",
      "default": "Reading the page,Opening Settings,Turning on backups,Done"
    },
    {
      "id": "targets",
      "type": "string",
      "role": "layout",
      "label": "Click targets",
      "description": "Semicolon-separated x,y points in percent of the frame.",
      "default": "25,47;76,30"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "default": "#0a84ff"
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "c694785df5993191fec42ec84e9d65ea69f98ad8",
    "source": "registry/components/agent-cursor/registry-item.json",
    "name": "agent-cursor"
  }
}
