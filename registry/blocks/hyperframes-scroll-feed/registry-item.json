{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-scroll-feed",
  "type": "hyperframes:component",
  "title": "Scroll Feed",
  "description": "A loop-friendly column of varied skeleton post cards scrolls upward with subtle motion trails and an agitated pace.",
  "tags": [
    "motion-primitive",
    "effects",
    "scroll",
    "feed",
    "loop",
    "agitation",
    "hyperframes-official"
  ],
  "jobs": [
    "demonstrate"
  ],
  "family": "effects",
  "profile": "continuous",
  "evidence": "Wave F U9 scroll-feed specification",
  "files": [
    {
      "path": "scroll-feed.html",
      "target": "compositions/components/scroll-feed.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "speed",
      "type": "enum",
      "role": "timing",
      "label": "Scroll speed",
      "description": "Pace of the upward feed movement.",
      "default": "doom",
      "options": [
        {
          "value": "doom",
          "label": "Doom"
        },
        {
          "value": "frantic",
          "label": "Frantic"
        }
      ]
    },
    {
      "id": "card_count",
      "type": "number",
      "role": "content",
      "label": "Card count",
      "description": "Number of skeleton posts in one repeated feed cycle.",
      "default": 6,
      "min": 4,
      "max": 10,
      "step": 1
    },
    {
      "id": "cues",
      "type": "string",
      "role": "timing",
      "label": "Cues",
      "description": "Comma-separated seconds (from mount start); each cue advances the feed by one card. Empty synthesizes evenly spaced flicks, one per card.",
      "default": ""
    },
    {
      "id": "exit",
      "type": "enum",
      "role": "timing",
      "label": "Exit",
      "description": "Optional departure. Default none: the feed scrolls until the frame cuts.",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "up",
          "label": "Up"
        }
      ]
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "daa44fcd753d9055aa3c954ad74f09a4e4389780",
    "source": "registry/components/scroll-feed/registry-item.json",
    "name": "scroll-feed"
  }
}
