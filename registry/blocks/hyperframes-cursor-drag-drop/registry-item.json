{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-cursor-drag-drop",
  "type": "hyperframes:component",
  "title": "Drag and Drop Cursor",
  "description": "A cursor grabs a task card, lifts and tilts it into its motion, carries it in lockstep to an empty column, drops it with a small settle, and the list closes the gap behind it.",
  "tags": [
    "cursor",
    "motion-primitive",
    "drag",
    "drop",
    "kanban",
    "product-demo",
    "hyperframes-official"
  ],
  "files": [
    {
      "path": "cursor-drag-drop.html",
      "target": "compositions/components/cursor-drag-drop.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "jobs": [
    "demonstrate"
  ],
  "family": "pointers",
  "profile": "interaction",
  "syncPoints": [
    {
      "id": "grab",
      "phase": "in",
      "offset": 0.7
    },
    {
      "id": "drop",
      "phase": "in",
      "offset": 2
    }
  ],
  "variables": [
    {
      "id": "card_label",
      "type": "string",
      "role": "content",
      "label": "Dragged card",
      "default": "Fix checkout validation"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "default": "#0a84ff"
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Board tone",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "c694785df5993191fec42ec84e9d65ea69f98ad8",
    "source": "registry/components/cursor-drag-drop/registry-item.json",
    "name": "cursor-drag-drop"
  }
}
