{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "chat-flow",
  "type": "hyperframes:block",
  "title": "Chat Flow",
  "description": "A messaging composition: an outgoing message types into the composer, the send button presses, and the bubble rises in; the other side shows a typing indicator that swaps into the reply, and reactions pop in. A pure orchestrator — every channel comes from a composed primitive's hook (Input, MessageBubble, TypingIndicator). Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT AND OFL-1.1",
  "bundledDependencies": [
    {
      "name": "culori",
      "version": "4.0.2",
      "license": "MIT"
    }
  ],
  "dimensions": {
    "width": 432,
    "height": 768
  },
  "duration": 12,
  "files": [
    {
      "path": "chat-flow.html",
      "target": "compositions/chat-flow.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "chat-flow.runtime.js",
      "target": "compositions/chat-flow.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/culori-LICENSE",
      "target": "THIRD_PARTY_LICENSES/remocn/culori-LICENSE",
      "type": "hyperframes:asset"
    },
    {
      "path": "contact-avatar.jpg",
      "target": "assets/social/contact-shadcn.jpg",
      "type": "hyperframes:asset"
    }
  ]
}
