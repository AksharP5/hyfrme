{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-vfx-portal",
  "type": "hyperframes:block",
  "title": "Portal",
  "description": "VFX composition block",
  "stability": "experimental",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "tags": [
