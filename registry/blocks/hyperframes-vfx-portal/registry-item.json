  },
  "params": [
    {
      "key": "--bg-color",
      "label": "Background",
      "type": "color",
      "default": "#000000"
    },
    {
      "key": "--portal-color",
      "label": "Portal color",
      "type": "color",
      "default": "#fafafa"
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
