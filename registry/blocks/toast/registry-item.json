{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "toast",
  "type": "hyperframes:block",
  "title": "Toast",
  "description": "A toast notification whose hidden/visible state is a pure function of the timeline. The Toast renderer is a pure function of a ToastStyle (opacity, translateY, scale); useToastTransition eases both the slide-in enter and the auto-dismiss exit. Variants default/success/error change the leading icon and its color. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT AND OFL-1.1",
  "bundledDependencies": [
    {
      "name": "culori",
      "version": "4.0.2",
      "license": "MIT"
    }
  ],
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 5.666666666666667,
  "files": [
    {
      "path": "toast.html",
      "target": "compositions/toast.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "toast.runtime.js",
      "target": "compositions/toast.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/culori-LICENSE",
      "target": "THIRD_PARTY_LICENSES/remocn/culori-LICENSE",
      "type": "hyperframes:asset"
    }
  ]
}
