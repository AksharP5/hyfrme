{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "imessage-chat-flow",
  "type": "hyperframes:block",
  "title": "iMessage Chat Flow",
  "description": "An iMessage-styled messaging composition: gray incoming and blue outgoing bubbles with tails, an in-thread typing bubble with dots, a Delivered label, and tapback-style reaction badges. The composer types the outgoing message before sending. Chrome icons come from lucide-react; self-contained otherwise, composing the caret and typing-indicator primitives. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "ui",
    "primitive",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT AND OFL-1.1 AND ISC",
  "bundledDependencies": [
    {
      "name": "lucide-react",
      "version": "1.7.0",
      "license": "ISC"
    },
    {
      "name": "culori",
      "version": "4.0.2",
      "license": "MIT"
    }
  ],
  "dimensions": {
    "width": 432,
    "height": 768
  },
  "duration": 12,
  "files": [
    {
      "path": "imessage-chat-flow.html",
      "target": "compositions/imessage-chat-flow.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "imessage-chat-flow.runtime.js",
      "target": "compositions/imessage-chat-flow.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/lucide-react-LICENSE",
      "target": "THIRD_PARTY_LICENSES/remocn/lucide-react-LICENSE",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/culori-LICENSE",
      "target": "THIRD_PARTY_LICENSES/remocn/culori-LICENSE",
      "type": "hyperframes:asset"
    },
    {
      "path": "contact-avatar.jpg",
      "target": "assets/social/contact-shadcn.jpg",
      "type": "hyperframes:asset"
    }
  ]
}
