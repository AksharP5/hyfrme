{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-scramble-reveal",
  "type": "hyperframes:component",
  "title": "Scramble Reveal",
  "description": "A deterministic hacker-style text reveal that cycles fixed glyph rows and locks the target string from left to right.",
  "tags": [
    "motion-primitive",
    "text-effects",
    "scramble",
    "reveal",
    "deterministic",
    "hyperframes-official"
  ],
  "jobs": [
    "reveal"
  ],
  "family": "text-effects",
  "profile": "decode",
  "evidence": "Wave H U27 design research: fixed-seed glyph cycling with authored left-to-right lock frames",
  "syncPoints": [
    {
      "id": "scramble-lock",
      "phase": "in",
      "offset": 1.5
    }
  ],
  "files": [
    {
      "path": "scramble-reveal.html",
      "target": "compositions/components/scramble-reveal.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Target string that resolves from deterministic wrong glyphs.",
      "default": "HYPERFRAMES"
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Color used by the text, prefix, and optional terminal frame.",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "style",
      "type": "enum",
      "role": "style",
      "label": "Style",
      "description": "Terminal frame or clean text-only presentation.",
      "default": "terminal",
      "options": [
        {
          "value": "terminal",
          "label": "Terminal"
        },
        {
          "value": "clean",
          "label": "Clean"
        }
      ]
    },
    {
      "id": "exit",
      "type": "enum",
      "role": "timing",
      "label": "Exit",
      "description": "Optional departure. Default none: the locked string holds until the frame cuts.",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "up",
          "label": "Up"
        }
      ]
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "daa44fcd753d9055aa3c954ad74f09a4e4389780",
    "source": "registry/components/scramble-reveal/registry-item.json",
    "name": "scramble-reveal"
  }
}
