  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "halftone-print",
  "type": "hyperframes:block",
  "title": "Halftone Print",
  "description": "Print a scene onto paper: each colour separates onto its own rotated screen of dots sized by the ink under them, slightly out of register the way a real press runs. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "filter",
    "html-in-canvas",
    "webgl",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT",
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 3,
  "files": [
    {
      "path": "halftone-print.html",
      "target": "compositions/halftone-print.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "halftone-print.runtime.js",
      "target": "compositions/halftone-print.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    }
  ]
