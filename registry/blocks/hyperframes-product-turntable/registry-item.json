{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-product-turntable",
  "type": "hyperframes:block",
  "title": "Product Turntable",
  "description": "A product turns a full revolution on a studio plinth in a seamless loop. Drop in a GLB or glTF model, or keep the built-in drink can with your own label.",
  "tags": [
    "3d-object",
    "three-js",
    "webgl",
    "product",
    "turntable",
    "glb",
    "loop",
    "hyperframes-official"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 6,
  "files": [
    {
      "path": "product-turntable.html",
      "target": "compositions/product-turntable.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "model_url",
      "type": "string",
      "role": "content",
      "label": "Model URL (.glb or .gltf)",
      "description": "Leave empty for the built-in drink can.",
      "default": ""
    },
    {
      "id": "product_name",
      "type": "string",
      "role": "content",
      "label": "Label wordmark",
      "default": "YUZU",
      "maxLength": 10
    },
    {
      "id": "flavor",
      "type": "string",
      "role": "content",
      "label": "Label line",
      "default": "Sparkling Citrus",
      "maxLength": 28
    },
    {
      "id": "caption",
      "type": "string",
      "role": "content",
      "label": "Caption",
      "default": "Sparkling Citrus · 355 ml",
      "maxLength": 40
    },
    {
      "id": "label_color",
      "type": "color",
      "role": "style",
      "label": "Label color",
      "default": "#f2c230"
    },
    {
      "id": "ink_color",
      "type": "color",
      "role": "style",
      "label": "Label ink",
      "default": "#1d2a24"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Backdrop",
      "default": "#e8e4dc"
    },
    {
      "id": "turns",
      "type": "number",
      "role": "motion",
      "label": "Turns per clip",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "c694785df5993191fec42ec84e9d65ea69f98ad8",
    "source": "registry/blocks/product-turntable/registry-item.json",
    "name": "product-turntable"
  }
}
