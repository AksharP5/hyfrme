{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "ascii-render",
  "type": "hyperframes:block",
  "title": "ASCII Render",
  "description": "Redraw a live scene as ASCII: the frame divides into glyph cells and each one becomes the character matching the brightness of the picture inside it. Compiled for deterministic HyperFrames playback by Hyfrme.",
  "tags": [
    "filter",
    "html-in-canvas",
    "webgl",
    "remocn-port"
  ],
  "author": "Hyfrme",
  "authorUrl": "https://github.com/AksharP5/hyfrme",
  "license": "MIT",
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "duration": 3,
  "files": [
    {
      "path": "ascii-render.html",
      "target": "compositions/ascii-render.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "ascii-render.runtime.js",
      "target": "compositions/ascii-render.runtime.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "Geist-Latin.woff2",
      "target": "assets/fonts/Geist-Latin.woff2",
      "type": "hyperframes:asset"
    },
    {
      "path": "licenses/Geist-OFL.txt",
      "target": "THIRD_PARTY_LICENSES/Geist-OFL.txt",
      "type": "hyperframes:asset"
    }
  ]
}
