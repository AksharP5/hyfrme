{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-cursor-context-menu",
  "type": "hyperframes:component",
  "title": "Context Menu Cursor",
  "description": "A cursor right-clicks a file, a context menu blooms from its tip, the hover highlight tracks the item under it, and the chosen action plays out: duplicate, rename, move to trash, or a confirmation toast.",
  "tags": [
    "cursor",
    "motion-primitive",
    "menu",
    "right-click",
    "desktop",
    "files",
    "hyperframes-official"
  ],
  "files": [
    {
      "path": "cursor-context-menu.html",
      "target": "compositions/components/cursor-context-menu.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "jobs": [
    "demonstrate"
  ],
  "family": "pointers",
  "profile": "interaction",
  "syncPoints": [
    {
      "id": "right-click",
      "phase": "in",
      "offset": 0.7
    },
    {
      "id": "menu-pick",
      "phase": "in",
      "offset": 1.85
    }
  ],
  "variables": [
    {
      "id": "items",
      "type": "string",
      "role": "content",
      "label": "Menu items",
      "default": "Open,Rename,Duplicate,Share,Move to Trash"
    },
    {
      "id": "pick",
      "type": "number",
      "role": "content",
      "label": "Chosen item (0 = first)",
      "default": 2,
      "min": 0,
      "max": 9,
      "step": 1
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "c694785df5993191fec42ec84e9d65ea69f98ad8",
    "source": "registry/components/cursor-context-menu/registry-item.json",
    "name": "cursor-context-menu"
  }
}
