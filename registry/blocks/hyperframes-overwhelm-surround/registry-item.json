{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hyperframes-overwhelm-surround",
  "type": "hyperframes:component",
  "title": "Overwhelm Surround",
  "description": "Tasks, tabs, pings, and notification bubbles accelerate inward around a calm central subject, turning overload into visible spatial pressure.",
  "tags": [
    "effects",
    "agitate",
    "overwhelm",
    "pressure",
    "notifications",
    "hyperframes-official"
  ],
  "jobs": [
    "agitate"
  ],
  "family": "effects",
  "profile": "holdable",
  "evidence": "SIM fixture; CORPUS blueprint",
  "files": [
    {
      "path": "overwhelm-surround.html",
      "target": "compositions/components/overwhelm-surround.html",
      "type": "hyperframes:snippet"
    },
    {
      "path": "licenses/HyperFrames-LICENSE",
      "target": "THIRD_PARTY_LICENSES/hyperframes/LICENSE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "count",
      "type": "number",
      "role": "content",
      "label": "Chip count",
      "description": "Number of tasks and notifications crowding the center.",
      "default": 16,
      "min": 8,
      "max": 24,
      "step": 1
    },
    {
      "id": "centerLabel",
      "type": "string",
      "role": "content",
      "label": "Center label",
      "description": "Text inside the calm central subject. Blank hides the text.",
      "default": "You"
    },
    {
      "id": "intensity",
      "type": "number",
      "role": "layout",
      "label": "Intensity",
      "description": "How tightly and quickly the chips crowd the center.",
      "default": 1,
      "min": 0.5,
      "max": 2,
      "step": 0.1
    }
  ],
  "license": "Apache-2.0",
  "origin": {
    "repository": "https://github.com/heygen-com/hyperframes",
    "commit": "daa44fcd753d9055aa3c954ad74f09a4e4389780",
    "source": "registry/components/overwhelm-surround/registry-item.json",
    "name": "overwhelm-surround"
  }
}
