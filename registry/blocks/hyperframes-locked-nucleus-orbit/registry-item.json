  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Nucleus label",
      "description": "Text displayed inside the fixed center nucleus.",
      "default": "core"
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Color used by the nucleus, rings, and satellite markers.",
