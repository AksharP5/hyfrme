      "options": [
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "satellites",
      "type": "number",
      "role": "layout",
      "label": "Satellites",
      "description": "Number of orbiting copy chips.",
      "default": 4,
      "min": 3,
      "max": 6,
      "step": 1
    }
  ],
